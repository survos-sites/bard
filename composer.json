{
    "type": "project",
    "name": "survos-sites/bard",
    "description": "Shakespeare corpus viewer and search playground",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.5",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-pdo_pgsql": "*",
        "doctrine/doctrine-bundle": "^3.3.2",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.7.3",
        "phpdocumentor/reflection-docblock": "^6.0",
        "phpstan/phpdoc-parser": "^2.3.6",
        "survos/fetch-bundle": "^2.34.29",
        "survos/field-bundle": "^2.34.29",
        "survos/tabler-bundle": "dev-main",
        "symfony/ai-bundle": "^0.14.1",
        "symfony/ai-open-ai-platform": "^0.14",
        "symfony/ai-postgres-store": "^0.14",
        "symfony/asset": "^8.1",
        "symfony/asset-mapper": "^8.1.8",
        "symfony/console": "^8.1.8",
        "symfony/doctrine-messenger": "^8.1.8",
        "symfony/dotenv": "^8.1.6",
        "symfony/expression-language": "^8.1.6",
        "symfony/flex": "^2",
        "symfony/form": "^8.1.8",
        "symfony/framework-bundle": "^8.1.8",
        "symfony/http-client": "^8.1.8",
        "symfony/intl": "^8.1",
        "symfony/mailer": "^8.1.7",
        "symfony/mime": "^8.1.7",
        "symfony/monolog-bundle": "^3.0|^4.1",
        "symfony/notifier": "^8.1",
        "symfony/process": "^8.1.7",
        "symfony/property-access": "^8.1",
        "symfony/property-info": "^8.1.8",
        "symfony/runtime": "^8.1",
        "symfony/security-bundle": "^8.1.8",
        "symfony/serializer": "^8.1.8",
        "symfony/stimulus-bundle": "^3.5.1",
        "symfony/string": "^8.1.7",
        "symfony/translation": "^8.1",
        "symfony/twig-bundle": "^8.1.7",
        "symfony/ux-turbo": "^3.5.1",
        "symfony/validator": "^8.1.8",
        "symfony/web-link": "^8.1",
        "symfony/yaml": "^8.1.8",
        "twig/extra-bundle": "^2.12|^3.29",
        "twig/twig": "^2.12|^3.30",
        "yethee/tiktoken": "^1.1",
        "zenstruck/bytes": "^1.1"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "^8.1"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "survos/deployment-bundle": "^2.34.38",
        "symfony/browser-kit": "^8.1",
        "symfony/css-selector": "^8.1.6",
        "symfony/debug-bundle": "^8.1",
        "symfony/maker-bundle": "^1.68",
        "symfony/stopwatch": "^8.1",
        "symfony/web-profiler-bundle": "^8.1.8"
    }
}
